# Transcription of the УМК-80 monitor listing
#
# Source: Р.Р.00004-01 12 01-1 «Учебный микропроцессорный комплект.
#         Системный монитор. Текст программы», 1986, литера О₁.
#         Printed by the ISIS-II 8080/8085 MACRO ASSEMBLER V4.0.
#         Pages 46-83 of docs/umk_docs.pdf (sheets −4− to −41−).
#
# Format:  LOC  OBJ | SOURCE
#   LOC  4-digit hex address, exactly as the listing prints it
#   OBJ  object bytes in hex, exactly as the listing prints them (may be absent)
#   |    separator
#   Lines starting with '#' are transcription notes.
#
# The OBJ column is the source of truth for the binary; the source column is
# reassembled separately and both results MUST agree byte for byte.
# See PLAN.md §4.

# ===== sheet −4− (MODULE PAGE 3): port declarations =====================
          | ; 1. ОПИСАНИЕ ПОРТОВ ВВОДА/ВЫВОДА
0000      |         ORG   0
00F8      | PORTA   EQU   0F8H          ; ПОРТ АДРЕСА
00F9      | PORTB   EQU   0F9H          ; ПОРТ ДАННЫХ
00FA      | PORTC   EQU   0FAH          ; ПОРТ СОСТОЯНИЯ
00FB      | CNTRRG  EQU   0FBH          ; ПОРТ УПРАВЛ. БИС
00FC      | DBGPORT EQU   0FCH          ; ПОРТ ПОШАГ. РЕЖ.
0076      | CNTRWRD EQU   76H           ; УПРАВЛЯЮЩЕЕ СЛОВО
0001      | STEPWRD EQU   1             ; УСТ. ПОШАГ. РЕЖИМА
0020      | NMBIND  EQU   00100000B     ; N ИНДИКАТ. N 5
0352      | TIME    EQU   850           ; ВРЕМЯ ДРЕБЕЗГА 10
0000      | ERASE   EQU   0             ; СБРОС ИНДИКАЦИИ
0006      | SPACE   EQU   6             ; КОД СИМВ.-ПРОБЕЛ
0007      | CR      EQU   7             ; КОД СИМВ.-ВОЗВРАТ
0001      | TYPEAD  EQU   1             ; ТИП ДАННЫХ-ADDRESS
0000      | TYPEBT  EQU   0             ; ТИП ДАННЫХ - BYTE
1000      | RAMEND  EQU   1000H         ; ВЕРХНЯЯ ГРАН. ОЗУ
002C      | LENTOS  EQU   44            ; ДЛ.ТАБЛ.ИСХ.ЗНАЧ. РЕГ.И ВЕКТ.ПРЕРЫВ.
0FCE      | BASETOS EQU   RAMEND-LENTOS-6   ; БАЗА В ОЗУ
0FCE      | STKPTR  EQU   BASETOS       ; ИСХ.ЗНАЧ. SP МОНИТ.
0FFA      | BUFCD   EQU   RAMEND-6      ; БУФЕР РЕГЕНЕР. ИНДИК.
0FEE      | USRSTTB EQU   BASETOS+32    ; АДР.ВЕКТ.ПРЕР. В ОЗУ
0000 C34000 |        JMP   BOOT

# ===== sheet −5− (MODULE PAGE 4): RST 1..6 vectors =========================
          | ; ОБРАБОТЧИКИ ПРЕРЫВАНИЙ ПОЛЬЗОВАТЕЛЯ.
          | ; 0-Й И 7-Й УРОВНИ ПРЕРЫВАНИЙ
          | ; ИСПОЛЬЗУЮТСЯ ПРОГРАММОЙ МОНИТОР.
0008      |         ORG   08H
0008 2AEE0F |       LHLD  USRSTTB       ; RST 1
000B E9   |         PCHL                ; ОБР. 1 УРОВЕНЯ
0010      |         ORG   10H
0010 2AF00F |       LHLD  USRSTTB+2     ; RST 2
0013 E9   |         PCHL                ; ОБР. 2 УРОВЕНЯ
0018      |         ORG   18H
0018 2AF20F |       LHLD  USRSTTB+4     ; RST 3
001B E9   |         PCHL                ; ОБР. 3 УРОВЕНЯ
0020      |         ORG   20H
0020 2AF40F |       LHLD  USRSTTB+6     ; RST 4
0023 E9   |         PCHL                ; ОБР. 4 УРОВЕНЯ
0028      |         ORG   28H
0028 2AF60F |       LHLD  USRSTTB+8     ; RST 5
002B E9   |         PCHL                ; ОБР. 5 УРОВЕНЯ
0030      |         ORG   30H
0030 2AF80F |       LHLD  USRSTTB+10    ; RST 6
0033 E9   |         PCHL                ; ОБР. 6 УРОВЕНЯ

# ===== sheet −6− (MODULE PAGE 5): RST 7 and initialisation ====================
          | ; 3. ИНИЦИАЛИЗАЦИЯ ПРОГРАММЫ МОНИТОР
0038      |         ORG   38H
          | ; ОБРАБОТКА ПРЕРЫВАНИЯ 7-ГО УРОВНЯ
0038 F5   |         PUSH  PSW
0039 AF   |         XRA   A             ; СБР.ПОШАГОВЫЙ РЕЖИМ
003A D3FC |         OUT   DBGPORT
003C F1   |         POP   PSW
003D C3B101 |       JMP   RESTART
          | BOOT:
          | ; ИНИЦИАЛИЗАЦИЯ СИСТЕМЫ МОНИТОР
          | ; УСТАНОВКА ИСХОДНЫХ ЗНАЧЕНИЙ РЕГИСТРОВ
0040 31CE0F |       LXI   SP,STKPTR     ; УСТ.SP МОНИТОРА
0043 21CE0F |       LXI   H,BASETOS     ; АДР.РЕГ.В ОЗУ
0046 01BD03 |       LXI   B,TOS         ; ИСХ.ЗНАЧ.РЕГ.
0049 162C |         MVI   D,LENTOS
          | MOVLP:
004B 0A   |         LDAX  B
004C 77   |         MOV   M,A
004D 23   |         INX   H
004E 03   |         INX   B
004F 15   |         DCR   D
0050 C24B00 |       JNZ   MOVLP
          | ; ИСХОДНОЕ ПРОГРАММИРОВАНИЕ БИС
0053 3E89 |         MVI   A,NOT CNTRWRD

# ===== sheet −7− (MODULE PAGE 6) ============================================
0055 D3FB |         OUT   CNTRRG
0057 CDC002 |       CALL  ERSIND        ; ГАШЕНИЕ ИНДИКАЦ.

# ===== sheet −8− (MODULE PAGE 7): START =====================================
          | ; 4. СТАРТ ПРОГРАММЫ МОНИТОР.
          | START:
          | ; ИНИЦИАЛ-Я БУФЕРА ВЫВОДА И ВЫВОД СИМВОЛА
          | ; "-"  ГОТОВ К ПРИЕМУ ДИРЕКТИВЫ
          | ; ПРИЕМ С КОНСОЛИ КЛЮЧЕВОГО СЛОВА ДИРЕКТИВЫ
          | ; ПЕРЕДАЧА УПРАВЛЕНИЯ МОДУЛЮ - ЗАДАНИЮ.
005A FB   |         EI
          | ; УСТАНОВКА УКАЗАТЕЛЯ СТЕКА МОНИТОРА
005B 31CE0F |       LXI   SP,STKPTR
          | ; ЕСЛИ МЛ. ИНДИКАТОР ПОГАШЕН, ВЫВЕСТИ "-"
          | ; СЛЕВА, ИНАЧЕ ВЫВОД "-" СПРАВА
005E 21FF0F |       LXI   H,BUFCD+5
0061 7E   |         MOV   A,M
0062 B7   |         ORA   A
0063 0605 |         MVI   B,5           ; АДР.СТ.ИНДИКАТОРА
0065 CA6A00 |       JZ    $+5
0068 0600 |         MVI   B,0           ; АДР.МЛ.ИНДИКАТОРА
006A 0E40 |         MVI   C,40H
006C CDB002 |       CALL  CONC
          | ; АДРЕС ВОЗВРАТА
006F 215A00 |       LXI   H,START
0072 E5   |         PUSH  H
          | ; ПРИЕМ КЛЮЧЕВОГО СИМВОЛА
0073 CDCD02 |       CALL  CI

# ===== sheet −9− (MODULE PAGE 8) ============================================
0076 CDC002 |       CALL  ERSIND
          | ; КОНТРОЛЬ
0079 FE06 |         CPI   6
007B D27602 |       JNC   ERROR
          | ; ВЫБОР ЗАДАНИЯ В C T B L
007E 216503 |       LXI   H,CTBL
0081 87   |         ADD   A
0082 5F   |         MOV   E,A
0083 1600 |         MVI   D,0
0085 19   |         DAD   D
          | ; <HL> - АДРЕС ЗАДАНИЯ
0086 7E   |         MOV   A,M
0087 23   |         INX   H
0088 66   |         MOV   H,M           ; СТ. БАЙТ АДРЕСА
0089 6F   |         MOV   L,A           ; МЛ. БАЙТ АДРЕСА
          | ; ПЕРЕДАЧА УПРАВЛЕНИЯ
008A E9   |         PCHL

# ===== sheet −10− (MODULE PAGE 9): the РГ directive =============================
          | ; 5. РЕАЛИЗАЦИЯ ДИРЕКТИВ ПРОГРАММЫ МОНИТОР
          | REPLRG:
          | ; 5.1. МОДИФИКАЦИЯ СОДЕРЖИМОГО РЕГИСТРОВ
008B CDC002 |       CALL  ERSIND        ; ПОГАСИТЬ ИНДИКАЦИЮ
008E CDCD02 |       CALL  CI            ; ПРИЕМ ИДЕНТ-РА РЕГ.
0091 FE34 |         CPI   '4'           ; КОНТРОЛЬ
0093 DA7602 |       JC    ERROR
0096 FE41 |         CPI   'A'           ; ЕСЛИ CODE>='A',
0098 DA9D00 |       JC    $+5           ; ТО CODE-7
009B DE07 |         SBI   7
          | ; ОПРЕДЕЛЕНИЕ АДРЕСА ХРАНЕНИЯ ЗАДАННОГО
          | ; РЕГИСТРА И ФИЗИЧ. КОДОВ СИМВОЛОВ ИДЕНТИ-
          | ; ФИЦИРУЮЩИХ РЕГИСТР ПО ТАБЛ. TBLRG
          | ; СМЕЩЕНИЕ В ТАБЛ.-(КОД ASCII AND 0FH) * 4
009D 215D03 |       LXI   H,TBLRG-20
00A0 E60F |         ANI   0FH
00A2 5F   |         MOV   E,A
00A3 87   |         ADD   A
00A4 87   |         ADD   A
00A5 83   |         ADD   E
00A6 1600 |         MVI   D,0
00A8 5F   |         MOV   E,A
00A9 19   |         DAD   D
          | ; <C> - КОД ИДЕНТИФИКАТОРА

# ===== sheet −11− (MODULE PAGE 10) ==========================================
00AA 0605 |         MVI   B,5
          | IDTOUT:
00AC 7E   |         MOV   A,M
00AD B7   |         ORA   A
00AE CAB700 |       JZ    $+9
00B1 4F   |         MOV   C,A
00B2 E5   |         PUSH  H
00B3 CDB002 |       CALL  CONC
00B6 E1   |         POP   H
00B7 23   |         INX   H
00B8 05   |         DCR   B
00B9 78   |         MOV   A,B
00BA FE02 |         CPI   2
00BC C2AC00 |       JNZ   IDTOUT
00BF E5   |         PUSH  H
00C0 0E40 |         MVI   C,40H
00C2 CDB002 |       CALL  CONC
00C5 E1   |         POP   H
          | ; <HL> - АДРЕС Я.П. ХРАНЕНИЯ РЕГИСТРА
00C6 7E   |         MOV   A,M
00C7 23   |         INX   H
00C8 66   |         MOV   H,M
00C9 6F   |         MOV   L,A
00CA 4E   |         MOV   C,M           ; ТЕК.ЗНАЧ.РЕГ.

# ===== sheet −12− (MODULE PAGE 11) ==========================================
00CB E5   |         PUSH  H
00CC CD8B02 |       CALL  COBYTE        ; ПЕЧАТЬ БАЙТА
00CF CD6A02 |       CALL  PCHK          ; ЕСЛИ РАЗДЕЛ.
00D2 E1   |         POP   H
00D3 DAC002 |       JC    ERSIND        ; КОНЕЦ
00D6 CA8B00 |       JZ    REPLRG        ; СЛЕД.РЕГИСТР
          | ; ПРИНЯТЬ НОВОЕ ЗНАЧ. РЕГИСТРА
00D9 E5   |         PUSH  H
00DA CDB902 |       CALL  ERSBT
00DD 0E00 |         MVI   C,TYPEBT
00DF CD3F02 |       CALL  PARM1
00E2 7D   |         MOV   A,L
00E3 E1   |         POP   H
00E4 77   |         MOV   M,A
00E5 D28B00 |       JNC   REPLRG
00E8 C3C002 |       JMP   ERSIND        ; ПОГАСИТЬ ИНДИКАЦИЮ
          | ; 5.2. МОДИФИКАЦИЯ СОДЕРЖИМОГО ЯЧЕЙКИ ПАМЯТИ
          | REPLM:
          | ; ПРИЕМ АДРЕСА Я.П.
00EB 0E01 |         MVI   C,TYPEAD
00ED CD3902 |       CALL  PARAM
          | COMEMLP:
          | ; ПЕЧАТЬ СОДЕРЖ. Я.П.

# ===== sheet −13− (MODULE PAGE 12) ==========================================
00F0 4E   |         MOV   C,M
00F1 E5   |         PUSH  H
00F2 CD8B02 |       CALL  COBYTE
          | ; ПРИЕМ СИМВОЛА
00F5 CD6A02 |       CALL  PCHK          ; ЕСЛИ РАЗДЕЛ., СЛЕД.ЯЧ
00F8 E1   |         POP   H
00F9 DAC002 |       JC    ERSIND        ; ЗАКОНЧИТЬ ДИРЕКТИВУ
00FC CA0E01 |       JZ    MEMNEXT
          | ; ПРИНЯТЬ НОВОЕ ЗНАЧЕНИЕ СОДЕРЖ. Я.П.
00FF E5   |         PUSH  H
0100 CDB902 |       CALL  ERSBT
0103 0E00 |         MVI   C,TYPEBT
0105 CD3F02 |       CALL  PARM1
0108 7D   |         MOV   A,L
0109 E1   |         POP   H
010A 77   |         MOV   M,A
010B DAC002 |       JC    ERSIND        ; ЗАКОНЧИТЬ
          | MEMNEXT:
          | ; ПЕРЕЙТИ К СЛЕД. Я.П.
010E 23   |         INX   H
010F 44   |         MOV   B,H
0110 4D   |         MOV   C,L
0111 E5   |         PUSH  H
0112 CDA302 |       CALL  COADR
0115 E1   |         POP   H

# ===== sheet −14− (MODULE PAGE 13): the СТ directive ============================
0116 C3F000 |       JMP   COMEMLP
          | ; 5.3. ВЫПОЛНЕНИЕ ПРОГРАММЫ ПОЛЬЗОВАТЕЛЯ
          | GOTO:
          | ; ПРЕДУСМОТРЕНА ВОЗМОЖНОСТЬ УСТАНОВКИ
          | ; ДО 2-Х ТОЧЕК ОСТАНОВА
0119 21D60F |       LXI   H,BASETOS+EXIT-TOS  ; АД.EXIT
011C E3   |         XTHL                ; В СТЕКЕ АДРЕС EXIT
011D CD6A02 |       CALL  PCHK
0120 CA2B01 |       JZ    G00           ; ВЫП.С ТЕК.АДРЕСА
0123 0E01 |         MVI   C,TYPEAD
0125 CD3F02 |       CALL  PARM1         ; ПРИЕМ НАЧ.АДРЕСА
0128 22E60F |       SHLD  BASETOS+PCLOC+1-TOS ; ЗП.АДР.
          |                             ; ВХОДА В ПРОГ.ПОЛЬЗ.
          | G00:
012B D8   |         RC                  ; ВЫПОЛНИТЬ
012C 110200 |       LXI   D,2           ; ПР.АДР.2-Х ТЧК.ОСТ.
          | G01:
012F CDC302 |       CALL  ERSADR        ; ПОГАСИТЬ АДР.ИНДИК.
0132 014002 |       LXI   B,240H        ; ВЫВОД "-" НА 2 ИНД.
0135 D5   |         PUSH  D
0136 CDB002 |       CALL  CONC
0139 CD3902 |       CALL  PARAM         ; ПРИЕМ АДРЕСА
013C D1   |         POP   D

# ===== sheet −15− (MODULE PAGE 14) ==========================================
013D E5   |         PUSH  H
013E 14   |         INR   D             ; КОЛ-ВО ПАРАМЕТРОВ+1
013F DA4601 |       JC    G02           ; ПАРАМЕТРЫ ПРИНЯТЫ
0142 1D   |         DCR   E
0143 C22F01 |       JNZ   G01
          | G02:
0146 D27602 |       JNC   ERROR         ; > 2-Х ТОЧЕК ОСТ.
          | ; ЗАПОМНИТЬ АДРЕСА ТОЧЕК ОСТАНОВА И
          | ; ЯЧЕЕК ПАМЯТИ В СПЕЦИАЛЬНОЙ ОБЛ.ОЗУ
          | ; УСТАНОВИТЬ В НИХ ТОЧКИ ПРЕРЫВАНИЯ
0149 21E80F |       LXI   H,BASETOS+TLOC-TOS
          | G03:
014C C1   |         POP   B             ; АДРЕС ТОЧКИ ОСТАНОВА
014D 71   |         MOV   M,C           ; СОХРАНИТЬ
014E 23   |         INX   H
014F 70   |         MOV   M,B
0150 23   |         INX   H
0151 0A   |         LDAX  B             ; СОДЕРЖ.ТОЧКИ ОСТАН.
0152 77   |         MOV   M,A           ; СОХРАНИТЬ
0153 3EFF |         MVI   A,0FFH        ; RST7
0155 02   |         STAX  B             ; УСТ. ПРЕРЫВАНИЕ
0156 23   |         INX   H
0157 15   |         DCR   D

# ===== sheet −16− (MODULE PAGE 15): the ЗК and ПМ directives ======================
0158 C24C01 |       JNZ   G03           ; 2 ТОЧКА ОСТАНОВА
015B C9   |         RET
          | ; 5.4. ЗАПОЛНЕНИЕ МАССИВА ОЗУ КОНСТАНТОЙ
          | FILE:
015C 0E02 |         MVI   C,2           ; ПРИНЯТЬ НАЧ. И КОН.
015E CD1F02 |       CALL  CIADR         ; АДРЕСА ОБЛАСТИ ОЗУ
0161 0E00 |         MVI   C,TYPEBT
0163 CD3902 |       CALL  PARAM         ; ПРИЕМ ДАННЫХ
0166 4D   |         MOV   C,L
0167 D1   |         POP   D             ; КОН.АДРЕС
0168 E1   |         POP   H             ; НАЧ.АДРЕС
0169 CD3402 |       CALL  COMPA1
016C DA7602 |       JC    ERROR
          | FILELP:
016F 71   |         MOV   M,C
0170 CD2F02 |       CALL  COMPA         ; ЕСЛИ HL > DE,
0173 D26F01 |       JNC   FILELP        ; CARRY = 1
0176 C3C002 |       JMP   ERSIND        ; ПОГАСИТЬ ИНД.
          | ; 5.5. КОПИРОВАНИЕ ОБЛАСТЕЙ ПАМЯТИ
          | MOVE:
0179 0E03 |         MVI   C,3           ; ПРИЕМ ПАРАМЕТРОВ
017B CD1F02 |       CALL  CIADR         ; ПЕРЕМЕЩЕНИЯ

# ===== sheet −17− (MODULE PAGE 16): the КС directive ============================
017E C1   |         POP   B             ; НАЧ.АДР. - КУДА
017F D1   |         POP   D             ; КОН.АДРЕС ИСТОЧНИКА
0180 E1   |         POP   H             ; НАЧ.АДРЕС ИСТОЧНИКА
0181 CD3402 |       CALL  COMPA1
0184 DA7602 |       JC    ERROR
          | MOVELP:
0187 7E   |         MOV   A,M
0188 02   |         STAX  B
0189 03   |         INX   B
018A CD2F02 |       CALL  COMPA
018D D28701 |       JNC   MOVELP
0190 C3C002 |       JMP   ERSIND
          | ; 5.6. ПОДСЧЕТ КОНТРОЛЬНОЙ СУММЫ
          | CHSUM:
          | ; ПОДСЧЕТ КС ЗАДАННОЙ ОБЛАСТИ ОЗУ
          | ; КС - ПРЕДСТАВЛЯЕТ СОБОЙ СУММУ ВСЕХ ЯЧЕЕК
          | ; ПАМЯТИ БЕЗ УЧЕТА ПЕРЕНОСА
0193 0E02 |         MVI   C,2           ; ПРИЕМ НАЧ.И КОН.
0195 CD1F02 |       CALL  CIADR         ; АДРЕСОВ
0198 D1   |         POP   D
0199 E1   |         POP   H
019A CD3402 |       CALL  COMPA1
019D DA7602 |       JC    ERROR

# ===== sheet −18− (MODULE PAGE 17) ==========================================
01A0 0E00 |         MVI   C,0           ; ИСХОДНОЕ ЗНАЧ. КС
          | CSUMLP:
01A2 79   |         MOV   A,C
01A3 86   |         ADD   M
01A4 4F   |         MOV   C,A
01A5 CD2F02 |       CALL  COMPA
01A8 D2A201 |       JNC   CSUMLP
01AB CD8B02 |       CALL  COBYTE        ; ВЫВОД ЗНАЧ. КС
01AE C3C302 |       JMP   ERSADR        ; ПОГАСИТЬ АД.ИНД.

# ===== sheet −19− (MODULE PAGE 18): RESTART (the ПР interrupt) ===============
          | ; 6. ОБРАБАТЫВАЮЩИЕ ПРОГРАММЫ.
03D5      | PLLOC   EQU   PCLOC+1
03D6      | PHLOC   EQU   PLLOC+1
03CB      | LLOC    EQU   HLLOC+1
03CC      | HLOC    EQU   LLOC+1
03C1      | SLLOC   EQU   SPLOC
03C2      | SHLOC   EQU   SLLOC+1
          | RESTART:
          | ; ОБРАБОТКА ПРЕРЫВАНИЯ 7-ГО УРОВНЯ
          | ; - СОХРАНИТЬ ТЕКУЩЕЕ СОСТОЯНИЕ ПРОЦЕССОРА
          | ; - ВОССТАНОВИТЬ ИСХ.ЗНАЧ.ТОЧЕК ПРЕРЫВАНИЯ
01B1 F3   |         DI
          | ; ЕСЛИ ПРЕРВАНА РАБОТА ПРОГРАММЫ МОНИТОР,
          | ; ПРЕРЫВАНИЕ ИГНОРИРОВАТЬ
01B2 E3   |         XTHL                ; HL-АДРЕС Т.ПРЕРЫВ.
01B3 2B   |         DCX   H             ; АДРЕС ТОЧКИ ОСТАНОВА
01B4 D5   |         PUSH  D
01B5 F5   |         PUSH  PSW
01B6 11E903 |       LXI   D,PCEND
01B9 7D   |         MOV   A,L
01BA 93   |         SUB   E
01BB 7C   |         MOV   A,H
01BC 9A   |         SBB   D
01BD DA7602 |       JC    ERROR         ; ПРЕРВАН МОНИТОР

# ===== sheet −20− (MODULE PAGE 19) ==========================================
01C0 F1   |         POP   PSW           ; ВОССТ-ТЬ ЗНАЧ.РЕГ.
01C1 D1   |         POP   D
01C2 23   |         INX   H             ; АДРЕС СЛЕД. КОМАНДЫ
01C3 E3   |         XTHL
          | ; СОХРАНИТЬ СОСТОЯНИЕ ПРОЦЕССОРА НА СТЕКЕ
          | ; ПОЛЬЗОВАТЕЛЯ
01C4 E5   |         PUSH  H
01C5 D5   |         PUSH  D
01C6 C5   |         PUSH  B
